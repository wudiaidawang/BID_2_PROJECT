# ========== LLM 配置 ==========
# 必填：你的 API Key
LLM_API_KEY=your_api_key_here
LLM_API_URL=https://api.hunyuan.cloud.tencent.com/v1/chat/completions
LLM_MODEL=hunyuan-standard

# ========== 数据路径 ==========
DATA_PATH_BIDS=./data/bid_data.xlsx
PDF_DIR=./data/pdfs

# ========== ChromaDB 配置 ==========
CHROMA_PERSIST_DIR=./chroma_db

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ========== 检索配置 ==========
TOP_K=5
VECTOR_RECALL=50
EMBEDDING_MODEL=BAAI/bge-small-zh
USE_RERANKER=true

# ========== 会话配置 ==========
SESSION_TTL=1800
MAX_HISTORY=10

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8000
DEBUG=true
